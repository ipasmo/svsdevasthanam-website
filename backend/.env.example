# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api

# ─── Database (PostgreSQL via Prisma) ───────────────────────────────────────
DATABASE_URL="postgresql://svs_user:svs_pass@localhost:5432/svs_db?schema=public"

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production_use_a_long_random_string
JWT_EXPIRES_IN=7d

# ─── AWS S3 (Production) ────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_S3_BUCKET=svs-devastanam-media

# ─── Local S3 via MinIO (Docker dev only – leave blank in production) ────────
# AWS_S3_ENDPOINT=http://localhost:9000
# AWS_S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# ─── Razorpay ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET

# ─── Frontend Origin (CORS) ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Rate Limiting ──────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
