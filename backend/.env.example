# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api
# Swagger at /api/docs: unset = on except in production. true/false forces it.
# SWAGGER_ENABLED=true

# ─── Database (PostgreSQL via Prisma) ───────────────────────────────────────
# Local: both URLs point at Docker Postgres.
# Neon: DATABASE_URL = pooled host (contains "-pooler"), DIRECT_URL = direct host.
#   DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/svs_db?sslmode=require&connect_timeout=15"
#   DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/svs_db?sslmode=require&connect_timeout=15"
DATABASE_URL="postgresql://svs_user:svs_pass@localhost:5432/svs_db?schema=public"
DIRECT_URL="postgresql://svs_user:svs_pass@localhost:5432/svs_db?schema=public"

# ─── Seed (npm run prisma:seed) ─────────────────────────────────────────────
# Required when NODE_ENV=production; min 12 chars. Locally defaults to Admin@123.
# SEED_ADMIN_PASSWORD=

# ─── JWT ────────────────────────────────────────────────────────────────────
# Required. Production: at least 32 random characters, or the API refuses to start.
JWT_SECRET=change_me_in_production_use_a_long_random_string
JWT_EXPIRES_IN=7d

# ─── AWS S3 (Production) ────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_S3_BUCKET=svs-devastanam-media
# Canned ACL sent with each upload. Leave empty for AWS buckets with ACLs disabled
# (the default) and make the bucket readable with a bucket policy instead.
AWS_S3_OBJECT_ACL=

# ─── Local S3 via MinIO (Docker dev only – leave blank in production) ────────
# Setting AWS_S3_ENDPOINT also switches the client to path-style URLs.
# AWS_S3_ENDPOINT=http://localhost:9000
# AWS_S3_OBJECT_ACL=public-read
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# ─── Razorpay ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET

# ─── Frontend Origin (CORS) ─────────────────────────────────────────────────
# Comma-separated exact origins, no trailing slash, no wildcards. Required in production.
# e.g. FRONTEND_URL=https://www.srivenkatasai.org,https://svs-devasthanam.netlify.app
FRONTEND_URL=http://localhost:3000

# ─── Rate Limiting ──────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
